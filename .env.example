# Copy to .env and fill in. Never commit .env.

# TideCloak master admin (local Docker). Use a strong random password.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Tide licence. Only the project owner fills these in, after reading https://tide.org/legal
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# TideCloak location
TIDECLOAK_URL=http://localhost:8080
REALM_NAME=claimchain
CLIENT_APP_URL=http://localhost:3000

# Local PostgreSQL container (see README).
DATABASE_URL=postgresql://claimchain:<password>@localhost:5432/claimchain
