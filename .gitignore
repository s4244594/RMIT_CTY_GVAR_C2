!**/.env.*.example
**/.npmrc

# Local password/credential files, private keys, and certificates.
**/passwords*.txt
**/credentials.json
**/secrets.json
**/.envrc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa
**/id_ed25519
**/secrets/
**/credentials/

# Local databases, backups, and runtime state.
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.dump
**/*.backup
**/*.sql.gz
**/*.log
.DS_Store
node_modules/
.tide-pack/
data/
