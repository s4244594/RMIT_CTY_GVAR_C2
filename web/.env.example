# Copy to .env and fill in. Never commit .env.

# Local PostgreSQL container (see the main README).
DATABASE_URL=postgresql://claimchain:<password>@localhost:5432/claimchain

# Secret the server uses to fingerprint signed claim steps until the Tide attestation
# contract is deployed. Any long random string. Anyone with this can forge a step.
STEP_SIGNING_SECRET=

# Local-only simulation and plan-encryption UI testing. Never enable in production.
AUTH_MODE=simulated
NEXT_PUBLIC_AUTH_MODE=simulated
